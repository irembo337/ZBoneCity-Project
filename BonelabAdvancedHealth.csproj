<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ZBoneCity</AssemblyName>
    <RootNamespace>BonelabAdvancedHealth</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <BonelabPath Condition="'$(BonelabPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\BONELAB</BonelabPath>
    <MelonLoaderPath>$(BonelabPath)\MelonLoader</MelonLoaderPath>
    <Il2CppPath>$(MelonLoaderPath)\Il2CppAssemblies</Il2CppPath>
    <MelonNet6Path>$(MelonLoaderPath)\net6</MelonNet6Path>
    <InstallAfterBuild Condition="'$(InstallAfterBuild)' == ''">false</InstallAfterBuild>
    <PackMarrow Condition="'$(PackMarrow)' == ''">false</PackMarrow>
    <PackCleanRelease Condition="'$(PackCleanRelease)' == ''">false</PackCleanRelease>
    <ModVersion Condition="'$(ModVersion)' == ''">1.0.4</ModVersion>
    <TargetPlatform Condition="'$(TargetPlatform)' == ''">Windows</TargetPlatform>
    <DefineConstants Condition="'$(TargetPlatform)' == 'Windows'">$(DefineConstants);UNITY_STANDALONE;ZBC_WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(TargetPlatform)' == 'Android'">$(DefineConstants);UNITY_ANDROID;ZBC_ANDROID</DefineConstants>
    <DefineConstants>$(DefineConstants);MELONLOADER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_magslide_decompiled_*\**\*.cs" />
    <Compile Remove="_luamod_decompiled\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonNet6Path)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonNet6Path)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonNet6Path)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BoneLib">
      <HintPath>$(BonelabPath)\Mods\BoneLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(Il2CppPath)\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(Il2CppPath)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Il2CppPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSLZ.Marrow">
      <HintPath>$(Il2CppPath)\Il2CppSLZ.Marrow.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(Il2CppPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Il2CppPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(Il2CppPath)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(Il2CppPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(Il2CppPath)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(Il2CppPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(Il2CppPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(Il2CppPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(Il2CppPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(Il2CppPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(Il2CppPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.XRModule">
      <HintPath>$(Il2CppPath)\UnityEngine.XRModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(Il2CppPath)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(Il2CppPath)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(Il2CppPath)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToBonelabMods" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(InstallAfterBuild)' == 'true' and Exists('$(BonelabPath)\Mods')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$game = Get-Process BONELAB_Steam_Windows64 -ErrorAction SilentlyContinue; if ($game) { Write-Host 'BONELAB is running; skipping auto-copy of the DLL.'; exit 0 }; Copy-Item -LiteralPath '&quot;$(TargetPath)&quot;' -Destination '&quot;$(BonelabPath)\Mods\ZBoneCity.dll&quot;' -Force&quot;" />
  </Target>

  <Target Name="PackMarrowModIO" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(PackMarrow)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Build-HybridMarrowPackage.ps1&quot; -Configuration &quot;$(Configuration)&quot; -Version &quot;$(ModVersion)&quot;" />
  </Target>

  <Target Name="PackCleanPlayerRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(PackCleanRelease)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Build-CleanPlayerRelease.ps1&quot; -Configuration &quot;$(Configuration)&quot; -Version &quot;$(ModVersion)&quot;" />
  </Target>
</Project>
